# Local-only configuration. Copy to .env.local and never commit credentials.
# Option A: Read static ODPS constructor literals from a local notebook.
MAXCOMPUTE_NOTEBOOK_PATH=D:\path\to\database-connection.ipynb

# Option B: Configure these four values in the deployment environment instead.
# MAXCOMPUTE_ACCESS_KEY_ID=
# MAXCOMPUTE_ACCESS_KEY_SECRET=
# MAXCOMPUTE_PROJECT=
# MAXCOMPUTE_ENDPOINT=

# Optional overrides
ATTRIBUTION_API_PORT=8010

# 登录与权限（可选）
# 首次启动自动初始化演示账号，可用以下变量覆盖初始密码：
# AUTH_ADMIN_PASSWORD=admin123
# AUTH_ANALYST_PASSWORD=analyst123
# AUTH_VIEWER_PASSWORD=viewer123
# AUTH_TOKEN_TTL_SECONDS=43200
# MAXCOMPUTE_TABLE=pb_biz_credit.lj_sx_cnt_analysis_summary
# ATTRIBUTION_CACHE_SECONDS=900
# ATTRIBUTION_QUERY_WORKERS=6

# 钉钉授信归因日报（只配置在 server/.env.local，不要提交真实值）
# 必须显式选择目标群环境；test 使用测试群，prod 使用正式群。
# DINGTALK_TARGET_ENV=test|prod
# 测试环境可兼容下面的旧变量，正式环境不会回退到测试群配置。
# DINGTALK_WEBHOOK_URL=
# DINGTALK_SECRET=
# DINGTALK_TEST_WEBHOOK_URL=
# DINGTALK_TEST_SECRET=
# DINGTALK_PROD_WEBHOOK_URL=
# DINGTALK_PROD_SECRET=
# 授信归因截图地址可选；未配置时仍会发送文字摘要
# ATTRIBUTION_WEB_URL=http://<内网地址>/risk-bi-platform/?page=attribution
# 资金归集明细链接可选（日报模板与授信归因一致，同样带“查看原图”）
# ATTRIBUTION_FUND_WEB_URL=http://<内网地址>/risk-bi-platform/?page=attribution&tab=fund
# S3 PNG 截图 + 钉钉图片消息（配置完整后优先使用此方式）
# 注意：钉钉服务端要自己去取 msgtype=image 的 picURL，所以对象必须公网可读；
# 配不了公网存储时不会失败，而是回退成“只发本机图片链接”的文字日报。
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DINGTALK_S3_BUCKET=transsnet-android-upload-image-prod
# DINGTALK_S3_REGION=eu-west-1
# DINGTALK_S3_PREFIX=credit_attribution
# 资金归集截图在 S3 中的对象前缀（默认复用 DINGTALK_S3_PREFIX）
# DINGTALK_S3_FUND_PREFIX=fund_attribution
# DINGTALK_S3_PUBLIC_BASE_URL=
# 使用阿里云 OSS 等 S3 兼容存储时补上下面两项（并确保对象 ACL 为 public-read）
# DINGTALK_S3_ENDPOINT_URL=https://oss-eu-central-1.aliyuncs.com
# DINGTALK_S3_ADDRESSING_STYLE=path
# 日报“查看原图”默认指向本机生成的 JPEG 缩略图（宽度 0 表示直接用整图）
# ATTRIBUTION_NOTIFY_THUMBNAIL_WIDTH=900
# ATTRIBUTION_NOTIFY_THUMBNAIL_QUALITY=85
# ATTRIBUTION_PUBLIC_BASE_URL=http://<内网地址>:8010
# ATTRIBUTION_NOTIFY_USERNAME=admin
# ATTRIBUTION_NOTIFY_PASSWORD=
# ATTRIBUTION_NOTIFY_THEME=teal
# ATTRIBUTION_BROWSER_EXECUTABLE_PATH=C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe

# ---- 日报可靠性（缺失自愈 + 补发 + 告警）----
# 一次最多补发几条历史日报（默认 1=只发当天，不回放 backlog，避免一次性刷屏；
# 想补回停机期间的历史日报改成 3，或用 server/scripts/backfill_notify.py 逐天补）
# ATTRIBUTION_NOTIFY_CATCHUP_MAX=1
# 最新可用分区落后期望分区超过多少天就不再补发（交给 15:00 缺口巡检告警）
# ATTRIBUTION_NOTIFY_MAX_STALE_DAYS=3
# 缺口巡检期望的分区相对昨天的偏移（0=昨天；上游 T+2 产数时改成 1）
# NOTIFY_WATCHDOG_LAG_DAYS=0
