{
  "version": "v2.2",
  "table": "pb_biz_credit.lj_sx_cnt_analysis_summary",
  "date_field": "create_date",
  "count_field": "cnt",
  "approval_fields": ["approval_cnt", "approval_jy0_cnt"],
  "lookback_days": 15,
  "dimensions": [
