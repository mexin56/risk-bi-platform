[Unit]
Description=Risk BI Dagster Scheduler
After=network-online.target risk-bi-platform.service
Wants=network-online.target

[Service]
Type=simple
User=jupyter-wenning
Group=jupyter-wenning
WorkingDirectory=/home/jupyter-wenning/risk-bi-platform/server
Environment=PYTHONUNBUFFERED=1
Environment=DAGSTER_HOME=/home/jupyter-wenning/risk-bi-platform/server/data/dagster_home
ExecStartPre=/usr/bin/mkdir -p /home/jupyter-wenning/risk-bi-platform/server/data/dagster_home
ExecStart=/home/jupyter-wenning/risk-bi-platform/.venv/bin/dagster-daemon run --workspace /home/jupyter-wenning/risk-bi-platform/server/workspace.yaml
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
